(defun ar:demo (/ p)
  (ar:units) (ar:layers)
  (setq p (getpoint "\nLewy dolny rog przykladu [Enter = 0,0]: "))
  (if p (setq p (trans p 1 0)) (setq p '(0.0 0.0 0.0)))
  (ar:process ar:demo-outer ar:demo-fields (ar:xy p))
  (princ "\nDemo uzywa OUTLINE z pliku, ale oblicza stale offsety od nowa.")
  (princ "\nTo nie jest bezstratna kopia wszystkich pomocniczych linii z pliku zrodlowego.")
)
(defun c:ARKADEMO () (ar:run 'ar:demo))
(defun c:ARKA ()
  (princ "\nARKADEMO  - przyklad z zalaczonego DXF, z aktualnymi ustawieniami")
  (princ "\nARKABARY  - twoje zamkniete obwody pol + opcjonalny obrys zewnetrzny")
  (princ "\nARKAPROFIL - sam przekroj, 1 otwarta polilinia")
  (princ "\nARKAUSTAW - odstep PANE, promien R, pion, ramiona MITRE")
  (princ "\nARKARESET - ustawienia z przykladu: 2 / 8 / 6 / 15 mm")
  (princ "\nWejscie: LWPOLYLINE, proste i luki kolowe, zamkniete, WCS XY Z=0.")
  (princ "\nNie interpretuje automatycznie sieci otwartych osi barow ani SPLINE.")
  (princ))
(princ "\nWczytano ARKA BARY V1. Polecenia: ARKA / ARKADEMO / ARKABARY / ARKAPROFIL.")
(princ)
